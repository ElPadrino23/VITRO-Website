{
  "name": "vitro-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "keep_vars": true,
  "vars": { "SITE_URL": "https://www.vitroscrubs.com" },
  "routes": [
    { "pattern": "www.vitroscrubs.com", "custom_domain": true },
    { "pattern": "vitroscrubs.com/*", "zone_name": "vitroscrubs.com" }
  ]
}